# Application
APP_ENV=development
LOG_LEVEL=INFO

# PostgreSQL (pgvector + FTS)
DATABASE_URL=postgresql+asyncpg://rag:rag@postgres:5432/rag

# Redis (query embedding cache)
REDIS_URL=redis://redis:6379/0

# LLM (OpenAI-compatible)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1

# Models
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
EMBEDDING_DEVICE=cpu

# TEI — empty URL falls back to in-process sentence-transformers
TEI_EMBEDDING_URL=http://localhost:7501
TEI_RERANKER_URL=http://localhost:7502
TEI_TIMEOUT_SECONDS=60
# HF_TOKEN=

# Parser Service (POST /parse → ParseResponse)
PARSE_API_BASE_URL=http://192.168.14.248:17000
PARSE_API_TIMEOUT_SECONDS=300
