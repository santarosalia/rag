{
  "settings": {
    "index": {
      "number_of_shards": 1,
      "number_of_replicas": 0,
      "knn": true,
      "knn.algo_param.ef_search": 100,
      "analysis": {
        "analyzer": {
          "korean": {
            "type": "custom",
            "tokenizer": "nori_tokenizer",
            "filter": ["lowercase", "nori_part_of_speech"]
          }
        }
      }
    }
  },
  "mappings": {
    "properties": {
      "chunk_id": { "type": "keyword" },
      "doc_id": { "type": "keyword" },
      "tenant_id": { "type": "keyword" },
      "content": {
        "type": "text",
        "analyzer": "korean",
        "fields": {
          "english": {
            "type": "text",
            "analyzer": "english"
          },
          "standard": {
            "type": "text",
            "analyzer": "standard"
          }
        }
      },
      "source": { "type": "keyword" },
      "filename": { "type": "keyword" },
      "page": { "type": "integer" },
      "chunk_index": { "type": "integer" },
      "token_count": { "type": "integer" },
      "content_hash": { "type": "keyword" },
      "created_at": { "type": "date" },
      "embedding": {
        "type": "knn_vector",
        "dimension": 1024,
        "method": {
          "name": "hnsw",
          "space_type": "cosinesimil",
          "engine": "nmslib",
          "parameters": {
            "ef_construction": 128,
            "m": 16
          }
        }
      }
    }
  }
}
